---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import { breadcrumbSchema, pageSchema } from '../../lib/schema';

const crumbs = [{ label: 'Our Place' }];
---

<Layout
  title="About Common Ground Therapy | Richmond, Virginia"
  description="Learn about Common Ground Therapy, a private counseling practice for adults in Richmond, Virginia."
  schema={pageSchema([breadcrumbSchema(crumbs, Astro.url.pathname)])}
>
  <PageHero
    eyebrow="Our place"
    title="Therapy built around the person in the room."
    intro="Common Ground Therapy is Avery Morgan’s counseling practice in Richmond, Virginia, offering individual therapy for adults."
    crumbs={crumbs}
  />

  <section class="manifesto">
    <div class="container manifesto-grid">
      <div class="manifesto-number">01</div>

      <div class="manifesto-copy">
        <p class="hand-label">The idea behind Common Ground</p>
        <blockquote>
          You do not need to fit yourself into a predetermined version of therapy.
        </blockquote>
      </div>

      <div class="manifesto-note">
        <p>
          Therapy begins with understanding what has been happening in your life
          and what you would like to be different. Some concerns are specific and
          easy to name. Others become clearer over time.
        </p>
        <p>
          You and Avery can decide together what deserves attention, what pace
          feels manageable, and what kind of support may be useful.
        </p>
      </div>
    </div>
  </section>

  <section class="principles">
    <div class="container">
      <div class="principles-heading">
        <p class="hand-label light">What you can expect</p>
        <h2>Three ideas that shape the room.</h2>
      </div>

      <div class="principle-collage">
        <article class="principle principle-one">
          <span>01</span>
          <h3>Individual attention</h3>
          <p>
            Common Ground Therapy provides one-to-one counseling for adults. The
            work stays focused on your experiences, concerns, and goals.
          </p>
        </article>

        <article class="principle principle-two">
          <span>02</span>
          <h3>Collaboration</h3>
          <p>
            Therapy is something you participate in rather than something done
            to you. Questions, preferences, uncertainty, and feedback are welcome.
          </p>
        </article>

        <article class="principle principle-three">
          <span>03</span>
          <h3>Room for context</h3>
          <p>
            Relationships, values, culture, beliefs, responsibilities, and life
            circumstances can all matter without requiring you to fit a particular mold.
          </p>
        </article>
      </div>
    </div>
  </section>

  <section class="starting-point">
    <div class="container starting-grid">
      <div class="starting-statement">
        <span>02</span>
        <h2>You do not need to know exactly what kind of therapy you need.</h2>
      </div>

      <div class="starting-note">
        <div class="tape" aria-hidden="true"></div>
        <p>
          The Services section describes some of the concerns people may bring
          to counseling. The Approaches section explains several methods Avery
          may use during the work.
        </p>
        <p>
          Both are starting points. A conversation with Avery can help you
          determine whether Common Ground Therapy fits what you are looking for.
        </p>

        <div class="starting-links">
          <a href="/services/">What we help with ↗</a>
          <a href="/approaches/">How we work ↗</a>
        </div>
      </div>
    </div>
  </section>

  <section class="counselor-band">
    <div class="container counselor-grid">
      <div class="counselor-visual" aria-hidden="true">
        <span class="shape plum"></span>
        <span class="shape coral"></span>
        <span class="shape gold"></span>
        <span class="head"></span>
        <span class="body"></span>
        <span class="note">Here for the whole story.</span>
      </div>

      <div class="counselor-copy">
        <p class="hand-label light">The counselor behind the practice</p>
        <h2>Meet Avery Morgan, LPC.</h2>
        <p>
          Avery’s education, clinical training, professional credentials, and
          therapeutic background are described in more detail on her profile.
        </p>
        <a class="profile-link" href="/about/avery-morgan/">
          View Avery’s profile →
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .manifesto,
  .principles,
  .starting-point,
  .counselor-band {
    padding: clamp(4.5rem,8vw,7rem) 0;
  }

  .hand-label {
    margin: 0 0 .7rem;
    color: #d85f40;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 1rem;
    font-style: italic;
    font-weight: 700;
  }

  .hand-label.light { color: #ffd7bf; }

  .manifesto {
    background: #fffdf8;
  }

  .manifesto-grid {
    display: grid;
    gap: 2rem;
    align-items: start;
  }

  .manifesto-number {
    color: #d85f40;
    font-size: .76rem;
    font-weight: 900;
    letter-spacing: .1em;
  }

  blockquote {
    max-width: 13ch;
    margin: 0;
    color: #512c45;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(2.7rem,5vw,5rem);
    font-weight: 500;
    line-height: .96;
    letter-spacing: -.05em;
  }

  .manifesto-note {
    max-width: 34rem;
    padding: 1.7rem;
    border-left: .45rem solid #f4b21a;
    background: #fff0e5;
  }

  .principles {
    overflow: hidden;
    background: #63384f;
  }

  .principles-heading {
    max-width: 46rem;
    margin-bottom: 2.7rem;
  }

  .principles-heading h2 {
    margin: 0;
    color: white;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(2.8rem,5vw,5rem);
    font-weight: 500;
    line-height: .98;
  }

  .principle-collage {
    display: grid;
    gap: 1rem;
  }

  .principle {
    padding: clamp(1.6rem,3vw,2.4rem);
    color: #512c45;
  }

  .principle > span {
    display: block;
    margin-bottom: 2rem;
    font-size: .74rem;
    font-weight: 900;
    letter-spacing: .1em;
  }

  .principle h3 {
    margin-bottom: .8rem;
    color: #512c45;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(2rem,3vw,3rem);
    font-weight: 500;
  }

  .principle p {
    max-width: 31rem;
  }

  .principle-one { background: #f2a082; }
  .principle-two { background: #f4c252; }
  .principle-three { background: #b1b99a; }

  .starting-point {
    background: #fff8ed;
  }

  .starting-grid {
    display: grid;
    gap: 3rem;
    align-items: center;
  }

  .starting-statement {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1.2rem;
    align-items: start;
  }

  .starting-statement > span {
    padding-top: .5rem;
    color: #d85f40;
    font-size: .72rem;
    font-weight: 900;
  }

  .starting-statement h2 {
    max-width: 11ch;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(2.7rem,5vw,4.8rem);
    font-weight: 500;
    line-height: .97;
    letter-spacing: -.045em;
  }

  .starting-note {
    position: relative;
    max-width: 34rem;
    padding: clamp(1.8rem,4vw,2.8rem);
    background: #f8e5d6;
    box-shadow: 0 18px 40px rgba(81,44,69,.08);
    transform: rotate(1.25deg);
  }

  .tape {
    position: absolute;
    width: 6.5rem;
    height: 1.4rem;
    left: 50%;
    top: -.7rem;
    background: rgba(244,194,82,.72);
    transform: translateX(-50%) rotate(-4deg);
  }

  .starting-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.5rem;
    margin-top: 1.5rem;
  }

  .starting-links a {
    color: #8a3f39;
    font-weight: 850;
    text-decoration: underline;
    text-underline-offset: .25rem;
  }

  .counselor-band {
    background: #d85f40;
    color: #fff3ea;
  }

  .counselor-grid {
    display: grid;
    gap: 3rem;
    align-items: center;
  }

  .counselor-visual {
    position: relative;
    min-height: 26rem;
  }

  .shape,
  .head,
  .body,
  .note {
    position: absolute;
    display: block;
  }

  .shape.plum {
    width: 15rem;
    height: 19rem;
    left: 12%;
    top: 1rem;
    border-radius: 8rem 8rem 1.2rem 1.2rem;
    background: #7f4565;
    transform: rotate(-5deg);
  }

  .shape.coral {
    width: 13rem;
    height: 8rem;
    right: 4%;
    bottom: 1rem;
    border-radius: 5rem 1.2rem 5rem 1.2rem;
    background: #f39b77;
  }

  .shape.gold {
    width: 6rem;
    height: 6rem;
    right: 10%;
    top: 1.5rem;
    border-radius: 50%;
    background: #f4b21a;
  }

  .head {
    width: 3.6rem;
    height: 3.6rem;
    left: calc(12% + 5.7rem);
    top: 5.2rem;
    z-index: 2;
    border-radius: 50%;
    background: #ffd3b8;
  }

  .body {
    width: 9rem;
    height: 8rem;
    left: calc(12% + 3rem);
    top: 9rem;
    z-index: 2;
    border-radius: 4.5rem 4.5rem 1rem 1rem;
    background: #fff0e4;
  }

  .note {
    right: 3%;
    top: 9rem;
    z-index: 3;
    max-width: 10rem;
    padding: .8rem 1rem;
    background: #fff8ed;
    color: #512c45;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: .95rem;
    font-style: italic;
    transform: rotate(4deg);
  }

  .counselor-copy h2 {
    color: white;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(2.8rem,5vw,4.8rem);
    font-weight: 500;
    line-height: .98;
  }

  .counselor-copy p:not(.hand-label) {
    max-width: 35rem;
  }

  .profile-link {
    display: inline-block;
    margin-top: 1rem;
    color: white;
    font-weight: 850;
    text-decoration: underline;
    text-underline-offset: .25rem;
  }

  @media(min-width:48rem) {
    .manifesto-grid {
      grid-template-columns: .13fr 1.17fr .7fr;
      gap: clamp(2rem,5vw,5rem);
    }

    .principle-collage {
      grid-template-columns: repeat(12,1fr);
      align-items: start;
      min-height: 28rem;
    }

    .principle-one { grid-column: 1 / 6; }
    .principle-two { grid-column: 5 / 10; margin-top: 5rem; }
    .principle-three { grid-column: 9 / 13; margin-top: 1.5rem; }

    .starting-grid,
    .counselor-grid {
      grid-template-columns: 1fr 1fr;
      gap: clamp(3rem,7vw,7rem);
    }
  }
</style>

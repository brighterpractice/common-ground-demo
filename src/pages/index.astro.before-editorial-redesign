---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import { appointmentUrl } from '../data/site';
import { homepageServices } from '../data/services';
import {
  organizationSchema,
  websiteSchema,
  pageSchema,
} from '../lib/schema';
---

<Layout
  title="Common Ground Therapy | Therapy in Richmond, Virginia"
  description="Individual counseling in Richmond, Virginia for adults navigating anxiety, grief, stress, relationships, transitions, and other difficult seasons of life."
  schema={pageSchema([organizationSchema(), websiteSchema()])}
>
  <section class="cg-hero">
    <div class="container cg-hero-grid">
      <div class="hero-copy">
        <p class="hero-label">Common Ground Therapy · Richmond, Virginia</p>

        <h1>
          Therapy for
          <span>real life,</span>
          real people.
        </h1>

        <p class="hero-intro">
          A welcoming place to talk through what feels heavy, confusing,
          repetitive, or simply harder than you want it to be.
        </p>

        <div class="hero-actions">
          <Button href={appointmentUrl} tracking="request-appointment">
            Request an appointment
          </Button>

          <a class="hero-link" href="/about/">
            Get to know the practice
          </a>
        </div>
      </div>

      <div class="hero-collage" aria-hidden="true">
        <div class="blob blob-plum"></div>
        <div class="blob blob-coral"></div>
        <div class="blob blob-gold"></div>

        <div class="person person-one">
          <span class="head"></span>
          <span class="body"></span>
        </div>

        <div class="person person-two">
          <span class="head"></span>
          <span class="body"></span>
        </div>

        <div class="conversation-card">
          <span class="conversation-mark">“</span>
          <p>There is room here for the whole story.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="cg-support">
    <div class="container">
      <div class="support-heading">
        <p class="eyebrow">What brings people in</p>
        <h2>You can start with whatever feels most present right now.</h2>
      </div>

      <div class="support-cloud">
        {
          homepageServices.slice(0, 7).map((service, index) => (
            <a
              href={`/services/${service.slug}/`}
              class:list={[
                'support-pill',
                `support-pill-${(index % 4) + 1}`,
              ]}
            >
              {service.title}
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="cg-message">
    <div class="container message-grid">
      <div class="message-visual" aria-hidden="true">
        <div class="message-card card-one">
          <span>01</span>
          <strong>Talk</strong>
        </div>

        <div class="message-card card-two">
          <span>02</span>
          <strong>Notice</strong>
        </div>

        <div class="message-card card-three">
          <span>03</span>
          <strong>Understand</strong>
        </div>

        <div class="message-card card-four">
          <span>04</span>
          <strong>Move forward</strong>
        </div>
      </div>

      <div class="message-copy">
        <p class="eyebrow">A different kind of starting point</p>

        <h2>Therapy does not have to feel formal or clinical.</h2>

        <p>
          You do not need a perfectly organized explanation of what is wrong
          before reaching out. The work can begin with a feeling, a pattern, a
          relationship, a recent change, or simply knowing that something does
          not feel right.
        </p>

        <p>
          Avery’s approach is collaborative, curious, and grounded in helping
          clients better understand themselves and the experiences shaping
          their lives.
        </p>

        <a class="text-link" href="/about/avery-morgan/">
          Meet Avery Morgan, LPC →
        </a>
      </div>
    </div>
  </section>

  <section class="cg-split">
    <div class="split-plum">
      <div>
        <p class="eyebrow light">Therapy approaches</p>

        <h2>Different people need different ways into the conversation.</h2>

        <p>
          Counseling can include several therapeutic approaches depending on
          what you are working through, what feels natural to you, and what
          seems most useful along the way.
        </p>

        <a href="/approaches/">
          Explore approaches →
        </a>
      </div>
    </div>

    <div class="split-gold">
      <div class="approach-stack">
        <a href="/approaches/internal-family-systems/">
          <span>01</span>
          Internal Family Systems
        </a>

        <a href="/approaches/somatic-experiencing/">
          <span>02</span>
          Somatic Experiencing
        </a>

        <a href="/approaches/emotionally-focused-therapy/">
          <span>03</span>
          Emotionally Focused Therapy
        </a>

        <a href="/approaches/mindfulness-based-therapy/">
          <span>04</span>
          Mindfulness-Based Therapy
        </a>
      </div>
    </div>
  </section>

  <section class="cg-meet">
    <div class="container meet-grid">
      <div class="meet-copy">
        <p class="eyebrow">Meet Avery</p>

        <h2>A thoughtful therapist with room for your personality too.</h2>

        <p>
          Avery Morgan, LPC, works with adults navigating stress, anxiety,
          grief, relationship patterns, emotional disconnection, and major life
          transitions.
        </p>

        <p>
          Sessions are meant to feel human, collaborative, and focused on what
          actually matters to you.
        </p>

        <a class="text-link" href="/about/avery-morgan/">
          Learn more about Avery →
        </a>
      </div>

      <div class="meet-portrait">
        <div class="portrait-backdrop"></div>

        <img
          src="/images/demo/clinician-placeholder.svg"
          alt="Clinician photo placeholder for Avery Morgan, LPC"
          loading="lazy"
        />

        <div class="portrait-caption">
          <strong>Avery Morgan, LPC</strong>
          <span>Individual therapy for adults</span>
        </div>
      </div>
    </div>
  </section>

  <section class="cg-steps">
    <div class="container">
      <div class="steps-heading">
        <p class="eyebrow">Getting started</p>
        <h2>No complicated process.</h2>
      </div>

      <div class="steps-row">
        <article>
          <span>01</span>
          <h3>Reach out</h3>
          <p>Send an appointment request when you are ready.</p>
        </article>

        <div class="step-divider"></div>

        <article>
          <span>02</span>
          <h3>Connect</h3>
          <p>Talk through practical details and what you are looking for.</p>
        </article>

        <div class="step-divider"></div>

        <article>
          <span>03</span>
          <h3>Begin</h3>
          <p>Start with whatever feels most important right now.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="cg-location">
    <div class="container location-card">
      <div>
        <p class="eyebrow">Richmond, Virginia</p>

        <h2>A welcoming space to begin something different.</h2>

        <p>
          Common Ground Therapy welcomes adults in Richmond and surrounding
          communities.
        </p>
      </div>

      <div class="location-shapes" aria-hidden="true">
        <span class="shape-square"></span>
        <span class="shape-pill"></span>
        <span class="shape-dot"></span>
      </div>
    </div>
  </section>

  <section class="cg-final">
    <div class="container final-inner">
      <div>
        <p class="final-kicker">A next step can be simple.</p>

        <h2>Bring whatever you are carrying.</h2>
      </div>

      <Button
        href={appointmentUrl}
        variant="light"
        tracking="request-appointment"
      >
        Request an appointment
      </Button>
    </div>
  </section>
</Layout>

<style>
  .cg-hero {
    position: relative;
    overflow: hidden;
    padding: clamp(4rem, 8vw, 7rem) 0;
    background: #fff8ed;
  }

  .cg-hero-grid {
    display: grid;
    gap: 3rem;
    align-items: center;
  }

  .hero-label {
    margin-bottom: 1.4rem;
    color: #c5563b;
    font-size: .76rem;
    font-weight: 800;
    letter-spacing: .13em;
    text-transform: uppercase;
  }

  .hero-copy h1 {
    max-width: 9ch;
    margin: 0;
    color: #4d3040;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(3.4rem, 8vw, 7rem);
    font-weight: 500;
    line-height: .9;
    letter-spacing: -.055em;
  }

  .hero-copy h1 span {
    color: #d85f40;
    font-style: italic;
  }

  .hero-intro {
    max-width: 38rem;
    margin-top: 1.6rem;
    color: #69545d;
    font-size: clamp(1.05rem, 1.8vw, 1.3rem);
    line-height: 1.7;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.3rem;
    align-items: center;
    margin-top: 2rem;
  }

  .hero-link,
  .text-link {
    color: #9f493b;
    font-weight: 800;
    text-decoration: none;
  }

  .hero-collage {
    position: relative;
    min-height: 30rem;
  }

  .blob {
    position: absolute;
  }

  .blob-plum {
    width: 17rem;
    height: 21rem;
    right: 2rem;
    top: 1rem;
    border-radius: 46% 54% 38% 62% / 55% 38% 62% 45%;
    background: #7f4565;
    transform: rotate(8deg);
  }

  .blob-coral {
    width: 13rem;
    height: 12rem;
    left: 1rem;
    bottom: 2rem;
    border-radius: 55% 45% 58% 42%;
    background: #f18767;
    transform: rotate(-10deg);
  }

  .blob-gold {
    width: 8rem;
    height: 8rem;
    right: 0;
    bottom: 1rem;
    border-radius: 2rem;
    background: #e5aa35;
    transform: rotate(15deg);
  }

  .person {
    position: absolute;
    z-index: 2;
  }

  .person .head {
    position: absolute;
    border-radius: 50%;
    background: #f8d8c6;
  }

  .person .body {
    position: absolute;
    border-radius: 50% 50% 20% 20%;
  }

  .person-one {
    width: 10rem;
    height: 14rem;
    right: 7rem;
    top: 5rem;
  }

  .person-one .head {
    width: 4rem;
    height: 4rem;
    left: 3rem;
  }

  .person-one .body {
    width: 9rem;
    height: 8rem;
    left: .5rem;
    bottom: 0;
    background: #f4b48f;
  }

  .person-two {
    width: 8rem;
    height: 11rem;
    left: 3.5rem;
    bottom: 3rem;
  }

  .person-two .head {
    width: 3.2rem;
    height: 3.2rem;
    left: 2.4rem;
  }

  .person-two .body {
    width: 7rem;
    height: 6.2rem;
    left: .5rem;
    bottom: 0;
    background: #87586f;
  }

  .conversation-card {
    position: absolute;
    z-index: 3;
    left: 1rem;
    top: 1.5rem;
    width: min(15rem, 60%);
    padding: 1.25rem;
    border-radius: 1.25rem;
    background: white;
    box-shadow: 0 18px 45px rgba(85,49,61,.12);
    transform: rotate(-4deg);
  }

  .conversation-mark {
    display: block;
    height: 2rem;
    color: #e5aa35;
    font-family: Georgia, serif;
    font-size: 3rem;
    line-height: 1;
  }

  .conversation-card p {
    margin: 0;
    color: #5a414c;
    font-weight: 750;
  }

  .cg-support {
    padding: clamp(4.5rem, 8vw, 7rem) 0;
    background: #fffdf8;
  }

  .support-heading {
    max-width: 47rem;
  }

  .support-heading h2 {
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(2.4rem, 5vw, 4rem);
    font-weight: 500;
  }

  .support-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: .8rem;
    margin-top: 2.5rem;
  }

  .support-pill {
    display: inline-flex;
    align-items: center;
    min-height: 3.4rem;
    padding: .75rem 1.25rem;
    border-radius: 999px;
    color: #4d3040;
    font-weight: 800;
    text-decoration: none;
    transition: transform .18s ease;
  }

  .support-pill:hover {
    transform: translateY(-3px);
  }

  .support-pill-1 {
    background: #f7b18f;
  }

  .support-pill-2 {
    background: #f4cf78;
  }

  .support-pill-3 {
    background: #e8c6d2;
  }

  .support-pill-4 {
    background: #d7ddcf;
  }

  .cg-message {
    padding: clamp(4.5rem, 8vw, 7rem) 0;
    background: #fae8dc;
  }

  .message-grid {
    display: grid;
    gap: 3rem;
    align-items: center;
  }

  .message-visual {
    position: relative;
    min-height: 28rem;
  }

  .message-card {
    position: absolute;
    display: grid;
    gap: .3rem;
    width: 10rem;
    padding: 1.3rem;
    border-radius: 1.4rem;
    box-shadow: 0 15px 35px rgba(85,49,61,.1);
  }

  .message-card span {
    font-size: .7rem;
    font-weight: 900;
  }

  .message-card strong {
    font-size: 1.1rem;
  }

  .card-one {
    left: 0;
    top: 2rem;
    background: #fffaf4;
    transform: rotate(-5deg);
  }

  .card-two {
    right: 1rem;
    top: 0;
    background: #e5aa35;
    transform: rotate(5deg);
  }

  .card-three {
    left: 3rem;
    bottom: 1rem;
    background: #f18767;
    transform: rotate(4deg);
  }

  .card-four {
    right: 0;
    bottom: 3rem;
    background: #7f4565;
    color: white;
    transform: rotate(-4deg);
  }

  .message-copy h2,
  .meet-copy h2,
  .steps-heading h2,
  .location-card h2,
  .cg-final h2 {
    font-family: Georgia, "Times New Roman", serif;
    font-weight: 500;
  }

  .message-copy h2 {
    max-width: 13ch;
    font-size: clamp(2.5rem, 5vw, 4.2rem);
  }

  .message-copy p + p {
    margin-top: 1rem;
  }

  .message-copy .text-link {
    display: inline-block;
    margin-top: 1.4rem;
  }

  .cg-split {
    display: grid;
  }

  .split-plum,
  .split-gold {
    padding: clamp(4rem, 8vw, 6rem) max(1.25rem, calc((100vw - 76rem) / 2));
  }

  .split-plum {
    background: #684052;
    color: #f7ece7;
  }

  .split-plum h2 {
    max-width: 14ch;
    color: white;
    font-family: Georgia, serif;
    font-size: clamp(2.3rem, 5vw, 4rem);
    font-weight: 500;
  }

  .split-plum .light {
    color: #f3bd99 !important;
  }

  .split-plum p:not(.eyebrow) {
    max-width: 36rem;
  }

  .split-plum a {
    display: inline-block;
    margin-top: 1.5rem;
    color: white;
    font-weight: 800;
    text-decoration: none;
  }

  .split-gold {
    display: flex;
    align-items: center;
    background: #e5aa35;
  }

  .approach-stack {
    width: 100%;
  }

  .approach-stack a {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: 1rem;
    padding: 1.15rem 0;
    border-bottom: 1px solid rgba(77,48,64,.25);
    color: #4d3040;
    font-weight: 800;
    text-decoration: none;
  }

  .approach-stack span {
    font-size: .72rem;
  }

  .cg-meet {
    padding: clamp(4.5rem, 8vw, 7rem) 0;
    background: #fffaf4;
  }

  .meet-grid {
    display: grid;
    gap: 3rem;
    align-items: center;
  }

  .meet-copy h2 {
    max-width: 14ch;
    font-size: clamp(2.5rem, 5vw, 4rem);
  }

  .meet-copy p + p {
    margin-top: 1rem;
  }

  .meet-copy .text-link {
    display: inline-block;
    margin-top: 1.4rem;
  }

  .meet-portrait {
    position: relative;
    min-height: 30rem;
  }

  .portrait-backdrop {
    position: absolute;
    inset: 1rem 0 3rem 4rem;
    border-radius: 3rem 1rem 3rem 1rem;
    background: #f4cf78;
    transform: rotate(3deg);
  }

  .meet-portrait img {
    position: absolute;
    z-index: 2;
    width: min(21rem, 78%);
    left: 1rem;
    top: 2rem;
    border-radius: 2rem;
    transform: rotate(-2deg);
    box-shadow: 0 22px 50px rgba(85,49,61,.15);
  }

  .portrait-caption {
    position: absolute;
    z-index: 3;
    right: 0;
    bottom: 1rem;
    display: grid;
    gap: .2rem;
    padding: 1rem 1.2rem;
    border-radius: 1rem;
    background: #7f4565;
    color: white;
    box-shadow: 0 16px 40px rgba(85,49,61,.16);
  }

  .portrait-caption span {
    font-size: .8rem;
    opacity: .8;
  }

  .cg-steps {
    padding: clamp(4.5rem, 8vw, 7rem) 0;
    background: #f7eee5;
  }

  .steps-heading h2 {
    font-size: clamp(2.4rem, 5vw, 4rem);
  }

  .steps-row {
    display: grid;
    gap: 1.5rem;
    margin-top: 2.5rem;
  }

  .steps-row article {
    padding: 1.5rem;
    border-radius: 1.2rem;
    background: #fffaf4;
  }

  .steps-row article > span {
    color: #d85f40;
    font-size: .72rem;
    font-weight: 900;
  }

  .steps-row h3 {
    margin-top: .5rem;
  }

  .step-divider {
    display: none;
  }

  .cg-location {
    padding: clamp(4.5rem, 8vw, 7rem) 0;
    background: #fffdf8;
  }

  .location-card {
    position: relative;
    overflow: hidden;
    display: grid;
    gap: 2rem;
    padding: clamp(2rem, 5vw, 4rem);
    border-radius: 2rem;
    background: #f7b18f;
  }

  .location-card > div:first-child {
    position: relative;
    z-index: 2;
    max-width: 42rem;
  }

  .location-card h2 {
    max-width: 15ch;
    font-size: clamp(2.3rem, 5vw, 3.8rem);
  }

  .location-shapes {
    position: relative;
    min-height: 12rem;
  }

  .shape-square,
  .shape-pill,
  .shape-dot {
    position: absolute;
    display: block;
  }

  .shape-square {
    width: 8rem;
    height: 8rem;
    right: 2rem;
    top: 1rem;
    border-radius: 1.5rem;
    background: #7f4565;
    transform: rotate(10deg);
  }

  .shape-pill {
    width: 12rem;
    height: 4rem;
    right: 7rem;
    bottom: 1rem;
    border-radius: 999px;
    background: #e5aa35;
    transform: rotate(-8deg);
  }

  .shape-dot {
    width: 4rem;
    height: 4rem;
    right: 0;
    bottom: 0;
    border-radius: 50%;
    background: #fffaf4;
  }

  .cg-final {
    padding: clamp(4.5rem, 8vw, 6rem) 0;
    background: #7f4565;
    color: white;
  }

  .final-inner {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
    align-items: end;
    justify-content: space-between;
  }

  .final-kicker {
    color: #f4cf78;
    font-weight: 800;
  }

  .cg-final h2 {
    max-width: 12ch;
    color: white;
    font-size: clamp(2.5rem, 5vw, 4rem);
  }

  @media (min-width:48rem) {
    .cg-hero-grid {
      grid-template-columns: 1.05fr .95fr;
      gap: clamp(3rem, 7vw, 7rem);
    }

    .message-grid {
      grid-template-columns: .9fr 1.1fr;
      gap: clamp(4rem, 8vw, 8rem);
    }

    .cg-split {
      grid-template-columns: 1fr 1fr;
    }

    .meet-grid {
      grid-template-columns: 1fr 1fr;
      gap: clamp(4rem, 8vw, 8rem);
    }

    .steps-row {
      grid-template-columns: 1fr auto 1fr auto 1fr;
      align-items: stretch;
    }

    .step-divider {
      display: block;
      width: 1px;
      background: #e3cdbd;
    }

    .location-card {
      grid-template-columns: 1.2fr .8fr;
      align-items: center;
    }
  }

  @media (max-width:47.999rem) {
    .hero-copy h1 {
      font-size: clamp(3.2rem, 16vw, 5rem);
    }

    .hero-actions {
      display: grid;
    }

    .hero-actions > * {
      width: 100%;
      justify-content: center;
      text-align: center;
    }

    .hero-collage {
      min-height: 24rem;
    }

    .blob-plum {
      width: 13rem;
      height: 16rem;
    }

    .blob-coral {
      width: 10rem;
      height: 9rem;
    }

    .person-one {
      right: 4rem;
    }

    .conversation-card {
      width: 55%;
    }

    .message-visual {
      min-height: 23rem;
    }

    .message-card {
      width: 8.5rem;
    }

    .portrait-backdrop {
      inset: 1rem 0 3rem 3rem;
    }

    .meet-portrait {
      min-height: 27rem;
    }

    .support-cloud {
      gap: .6rem;
    }

    .support-pill {
      min-height: 3rem;
      padding: .65rem 1rem;
      font-size: .9rem;
    }
  }
</style>

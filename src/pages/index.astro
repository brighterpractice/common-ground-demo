---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import { appointmentUrl } from '../data/site';
import { homepageServices } from '../data/services';
import {
  organizationSchema,
  websiteSchema,
  pageSchema,
} from '../lib/schema';
---

<Layout
  title="Common Ground Therapy | Therapy in Richmond, Virginia"
  description="Individual counseling in Richmond, Virginia for adults navigating anxiety, grief, stress, relationships, transitions, and difficult seasons of life."
  schema={pageSchema([organizationSchema(), websiteSchema()])}
>
  <!-- HERO -->
  <section class="cg-hero">
    <div class="hero-dots" aria-hidden="true">
      <span></span><span></span><span></span><span></span><span></span>
      <span></span><span></span><span></span><span></span>
    </div>

    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="kicker">Common Ground Therapy · Richmond, Virginia</p>

        <h1>
          Therapy for
          <em>real life,</em>
          real people.
        </h1>

        <p class="hero-intro">
          A warm, down-to-earth place to talk about what feels heavy,
          confusing, repetitive, or simply harder than you want it to be.
        </p>

        <div class="hero-actions">
          <Button href={appointmentUrl} tracking="request-appointment">
            Request an appointment
          </Button>

          <a href="/about/" class="underlined-link">
            Meet the practice →
          </a>
        </div>
      </div>

      <div class="hero-scene" aria-hidden="true">
        <div class="scene-plum"></div>
        <div class="scene-orange"></div>
        <div class="scene-yellow"></div>

        <div class="figure figure-left">
          <span class="figure-head"></span>
          <span class="figure-body"></span>
          <span class="figure-arm"></span>
        </div>

        <div class="figure figure-right">
          <span class="figure-head"></span>
          <span class="figure-body"></span>
        </div>

        <div class="speech-card">
          <span>“</span>
          <p>You don’t have to have it all figured out.</p>
        </div>

        <div class="mini-note">
          <strong>Start where you are.</strong>
        </div>
      </div>
    </div>
  </section>

  <!-- COLOR STRIP -->
  <div class="color-strip" aria-hidden="true">
    <span></span>
    <span></span>
    <span></span>
    <span></span>
  </div>

  <!-- WHAT BRINGS PEOPLE IN -->
  <section class="cg-needs">
    <div class="container needs-grid">
      <div class="needs-heading">
        <p class="hand-label">What brings people in</p>

        <h2>
          Start with whatever feels
          <span>most present</span>
          right now.
        </h2>

        <a href="/services/" class="underlined-link">
          Explore all services →
        </a>
      </div>

      <div class="needs-cloud">
        {
          homepageServices.slice(0, 7).map((service, index) => (
            <a
              href={`/services/${service.slug}/`}
              class:list={[
                'need-chip',
                `chip-${(index % 5) + 1}`,
              ]}
            >
              <span class="chip-dot"></span>
              {service.title}
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- HOW WE WORK -->
  <section class="cg-process">
    <div class="container">
      <div class="process-heading">
        <p class="hand-label">How we work together</p>
        <h2>Therapy can feel human.</h2>
      </div>

      <div class="process-flow">
        <article class="process-card process-1">
          <span class="number">01</span>
          <div class="process-icon">•••</div>
          <h3>Talk</h3>
          <p>Share what is on your mind at your own pace.</p>
        </article>

        <div class="connector connector-one" aria-hidden="true">→</div>

        <article class="process-card process-2">
          <span class="number">02</span>
          <div class="process-icon">?</div>
          <h3>Explore</h3>
          <p>Notice patterns, feelings, and experiences together.</p>
        </article>

        <div class="connector connector-two" aria-hidden="true">→</div>

        <article class="process-card process-3">
          <span class="number">03</span>
          <div class="process-icon">✦</div>
          <h3>Understand</h3>
          <p>Make sense of what may be happening underneath.</p>
        </article>

        <div class="connector connector-three" aria-hidden="true">→</div>

        <article class="process-card process-4">
          <span class="number">04</span>
          <div class="process-icon">↗</div>
          <h3>Move forward</h3>
          <p>Build awareness, choices, and new possibilities.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- BIG STATEMENT -->
  <section class="cg-statement">
    <div class="statement-orange" aria-hidden="true"></div>

    <div class="container statement-grid">
      <p class="statement-number">01</p>

      <blockquote>
        You are allowed to bring the
        <em>messy version</em>
        of the story.
      </blockquote>

      <div class="statement-copy">
        <p>
          You do not need the right diagnosis, the perfect explanation, or a
          polished version of what has been happening.
        </p>

        <p>
          Therapy can begin with a feeling, a conflict, a loss, a pattern,
          or simply knowing that something needs to change.
        </p>
      </div>
    </div>
  </section>

  <!-- AVERY -->
  <section class="cg-avery">
    <div class="container avery-grid">
      <div class="avery-photo-area">
        <div class="photo-shape"></div>

        <div class="photo-card">
          <div class="tape" aria-hidden="true"></div>

          <img
            src="/images/demo/clinician-placeholder.svg"
            alt="Clinician photo placeholder for Avery Morgan, LPC"
            loading="lazy"
          />

          <p>Avery Morgan, LPC</p>
        </div>

        <div class="avery-dots" aria-hidden="true">
          <span></span><span></span><span></span>
          <span></span><span></span><span></span>
          <span></span><span></span><span></span>
        </div>
      </div>

      <div class="avery-copy">
        <p class="hand-label">Meet Avery Morgan, LPC</p>

        <h2>
          Thoughtful,
          <span>down-to-earth,</span>
          and here for the whole you.
        </h2>

        <p>
          Avery works with adults navigating stress, anxiety, grief,
          relationship patterns, emotional disconnection, and major life
          transitions.
        </p>

        <p>
          Sessions are collaborative, curious, and centered around the person
          sitting in the room—not around forcing everyone into the same mold.
        </p>

        <a href="/about/avery-morgan/" class="underlined-link">
          Learn more about Avery →
        </a>
      </div>
    </div>
  </section>

  <!-- APPROACHES -->
  <section class="cg-approaches">
    <div class="approach-copy">
      <div>
        <p class="hand-label light">More than one way in</p>

        <h2>
          Different people connect with therapy in different ways.
        </h2>

        <p>
          Avery may draw from several therapeutic approaches depending on what
          you are experiencing and what feels useful in the work.
        </p>

        <a href="/approaches/">Explore approaches →</a>
      </div>
    </div>

    <div class="approach-list">
      <a href="/approaches/internal-family-systems/">
        <span>01</span>
        <strong>Internal Family Systems</strong>
        <b>↗</b>
      </a>

      <a href="/approaches/somatic-experiencing/">
        <span>02</span>
        <strong>Somatic Experiencing</strong>
        <b>↗</b>
      </a>

      <a href="/approaches/emotionally-focused-therapy/">
        <span>03</span>
        <strong>Emotionally Focused Therapy</strong>
        <b>↗</b>
      </a>

      <a href="/approaches/mindfulness-based-therapy/">
        <span>04</span>
        <strong>Mindfulness-Based Therapy</strong>
        <b>↗</b>
      </a>
    </div>
  </section>

  <!-- LOCATION / PERSONALITY BLOCK -->
  <section class="cg-richmond">
    <div class="container richmond-card">
      <div class="richmond-copy">
        <p class="hand-label">Richmond, Virginia</p>

        <h2>
          Connection.
          <span>Understanding.</span>
          Growth.
        </h2>

        <p>
          Common Ground Therapy welcomes adults in Richmond and surrounding
          communities.
        </p>
      </div>

      <div class="richmond-art" aria-hidden="true">
        <div class="big-dot"></div>
        <div class="pill"></div>

        <div class="people-mini">
          <span class="mini-head one"></span>
          <span class="mini-body one"></span>
          <span class="mini-head two"></span>
          <span class="mini-body two"></span>
        </div>
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="cg-final">
    <div class="container final-grid">
      <div>
        <p class="hand-label">A next step can be simple.</p>
        <h2>Bring whatever you are carrying.</h2>
      </div>

      <Button
        href={appointmentUrl}
        variant="light"
        tracking="request-appointment"
      >
        Request an appointment
      </Button>
    </div>
  </section>
</Layout>

<style>
  :global(body) {
    background: #fff8ed;
  }

  .cg-hero {
    position: relative;
    overflow: hidden;
    padding: clamp(4.5rem, 9vw, 8rem) 0 4rem;
    background: #fff8ed;
  }

  .hero-grid {
    display: grid;
    gap: 3rem;
    align-items: center;
  }

  .kicker,
  .hand-label {
    color: #d85f40;
    font-size: .78rem;
    font-weight: 850;
    letter-spacing: .1em;
  }

  .hand-label {
    font-family: Georgia, serif;
    font-size: 1rem;
    font-style: italic;
    letter-spacing: .03em;
    text-transform: none;
  }

  .hero-copy h1 {
    max-width: 8.5ch;
    margin: .5rem 0 0;
    color: #512c45;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(3.8rem, 8.5vw, 7.4rem);
    font-weight: 500;
    line-height: .88;
    letter-spacing: -.06em;
  }

  .hero-copy h1 em {
    display: block;
    color: #ed5c31;
    font-weight: 500;
  }

  .hero-intro {
    max-width: 37rem;
    margin-top: 1.8rem;
    color: #65505a;
    font-size: clamp(1.05rem, 1.6vw, 1.25rem);
    line-height: 1.7;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.5rem;
    align-items: center;
    margin-top: 2rem;
  }

  .underlined-link {
    color: #a74636;
    font-weight: 800;
    text-decoration: underline;
    text-decoration-color: #ed9a78;
    text-underline-offset: .25rem;
  }

  .hero-scene {
    position: relative;
    min-height: 32rem;
  }

  .scene-plum,
  .scene-orange,
  .scene-yellow {
    position: absolute;
  }

  .scene-plum {
    width: 18rem;
    height: 22rem;
    right: 0;
    top: 0;
    border-radius: 55% 45% 42% 58% / 48% 42% 58% 52%;
    background: #7f4565;
    transform: rotate(8deg);
  }

  .scene-orange {
    width: 15rem;
    height: 13rem;
    left: 0;
    bottom: 1rem;
    border-radius: 50% 45% 55% 45%;
    background: #f47752;
    transform: rotate(-8deg);
  }

  .scene-yellow {
    width: 9rem;
    height: 9rem;
    right: 1rem;
    bottom: 0;
    border-radius: 2rem 4rem 2rem 4rem;
    background: #efa916;
    transform: rotate(12deg);
  }

  .figure {
    position: absolute;
    z-index: 2;
  }

  .figure-head,
  .figure-body,
  .figure-arm {
    position: absolute;
    display: block;
  }

  .figure-head {
    border-radius: 50%;
    background: #f5c3a7;
  }

  .figure-left {
    width: 11rem;
    height: 16rem;
    left: 3rem;
    bottom: 2rem;
  }

  .figure-left .figure-head {
    width: 4rem;
    height: 4rem;
    left: 3.3rem;
  }

  .figure-left .figure-body {
    width: 10rem;
    height: 10rem;
    left: .5rem;
    bottom: 0;
    border-radius: 5rem 5rem 1rem 1rem;
    background: #d95637;
  }

  .figure-left .figure-arm {
    width: 7rem;
    height: 2rem;
    right: -3.5rem;
    top: 7rem;
    border-radius: 999px;
    background: #d95637;
    transform: rotate(-25deg);
  }

  .figure-right {
    width: 10rem;
    height: 14rem;
    right: 5rem;
    bottom: 2rem;
  }

  .figure-right .figure-head {
    width: 3.8rem;
    height: 3.8rem;
    left: 3.1rem;
  }

  .figure-right .figure-body {
    width: 9rem;
    height: 8rem;
    left: .5rem;
    bottom: 0;
    border-radius: 4.5rem 4.5rem .8rem .8rem;
    background: #62354f;
  }

  .speech-card {
    position: absolute;
    z-index: 4;
    width: 14rem;
    left: 0;
    top: 1.5rem;
    padding: 1.2rem;
    border-radius: 1.3rem 1.3rem 1.3rem .2rem;
    background: #fffdf8;
    box-shadow: 0 16px 38px rgba(81,44,69,.12);
    transform: rotate(-4deg);
  }

  .speech-card span {
    display: block;
    height: 1.7rem;
    color: #efa916;
    font-family: Georgia, serif;
    font-size: 3rem;
    line-height: .8;
  }

  .speech-card p {
    margin: 0;
    color: #513544;
    font-weight: 800;
  }

  .mini-note {
    position: absolute;
    z-index: 4;
    right: 0;
    top: 13rem;
    padding: .8rem 1rem;
    border-radius: 999px;
    background: #efa916;
    color: #512c45;
    transform: rotate(5deg);
  }

  .hero-dots {
    position: absolute;
    left: 2vw;
    bottom: 2rem;
    display: grid;
    grid-template-columns: repeat(3, .45rem);
    gap: .45rem;
  }

  .hero-dots span,
  .avery-dots span {
    width: .45rem;
    height: .45rem;
    border-radius: 50%;
    background: #ed5c31;
  }

  .color-strip {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    height: .55rem;
  }

  .color-strip span:nth-child(1) { background:#ed5c31; }
  .color-strip span:nth-child(2) { background:#efa916; }
  .color-strip span:nth-child(3) { background:#7f4565; }
  .color-strip span:nth-child(4) { background:#778873; }

  .cg-needs {
    padding: clamp(4.5rem, 8vw, 7rem) 0;
    background: #ff9d70;
  }

  .needs-grid {
    display: grid;
    gap: 3rem;
  }

  .needs-heading h2 {
    max-width: 12ch;
    color: #512c45;
    font-family: Georgia, serif;
    font-size: clamp(2.7rem, 5vw, 4.5rem);
    font-weight: 500;
    line-height: 1;
  }

  .needs-heading h2 span {
    color: #fff8ed;
    font-style: italic;
  }

  .needs-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: .8rem;
    align-content: center;
  }

  .need-chip {
    display: inline-flex;
    gap: .65rem;
    align-items: center;
    min-height: 3.3rem;
    padding: .75rem 1.1rem;
    border-radius: 999px;
    color: #512c45;
    font-weight: 850;
    text-decoration: none;
    box-shadow: 0 8px 18px rgba(81,44,69,.08);
  }

  .chip-dot {
    width: .65rem;
    height: .65rem;
    border-radius: 50%;
  }

  .chip-1 { background:#fff8ed; }
  .chip-1 .chip-dot { background:#efa916; }

  .chip-2 { background:#ffe6d6; }
  .chip-2 .chip-dot { background:#ed5c31; }

  .chip-3 { background:#f0d7e1; }
  .chip-3 .chip-dot { background:#7f4565; }

  .chip-4 { background:#e5eadf; }
  .chip-4 .chip-dot { background:#778873; }

  .chip-5 { background:#ffd57c; }
  .chip-5 .chip-dot { background:#512c45; }

  .cg-process {
    padding: clamp(4.5rem, 8vw, 7rem) 0;
    overflow: hidden;
    background: #fff8ed;
  }

  .process-heading {
    margin-bottom: 3rem;
  }

  .process-heading h2 {
    font-family: Georgia, serif;
    font-size: clamp(2.8rem, 5vw, 4.6rem);
    font-weight: 500;
  }

  .process-flow {
    display: grid;
    gap: 1rem;
  }

  .process-card {
    position: relative;
    padding: 1.5rem;
    border-radius: 2.5rem 1rem 2.5rem 1rem;
    color: #512c45;
  }

  .process-1 { background:#f8ded6; }
  .process-2 { background:#ffe6bd; }
  .process-3 { background:#f4c4ad; }
  .process-4 { background:#dce3d5; }

  .number {
    color: #a74636;
    font-size: .72rem;
    font-weight: 900;
  }

  .process-icon {
    display: grid;
    width: 3rem;
    height: 3rem;
    place-items: center;
    margin: 1rem 0;
    border-radius: 50%;
    background: rgba(255,255,255,.6);
    font-weight: 900;
  }

  .process-card h3 {
    margin: 0;
    font-family: Georgia, serif;
    font-size: 1.45rem;
  }

  .process-card p {
    margin: .7rem 0 0;
  }

  .connector {
    display: none;
  }

  .cg-statement {
    position: relative;
    overflow: hidden;
    padding: clamp(5rem, 10vw, 9rem) 0;
    background: #7f4565;
    color: #fff1e7;
  }

  .statement-orange {
    position: absolute;
    width: 19rem;
    height: 19rem;
    right: -7rem;
    bottom: -8rem;
    border-radius: 5rem 2rem 5rem 2rem;
    background: #ed5c31;
    transform: rotate(18deg);
  }

  .statement-grid {
    position: relative;
    z-index: 2;
    display: grid;
    gap: 2rem;
  }

  .statement-number {
    color: #efa916;
    font-weight: 900;
  }

  .cg-statement blockquote {
    max-width: 13ch;
    margin: 0;
    color: white;
    font-family: Georgia, serif;
    font-size: clamp(2.8rem, 6vw, 5.2rem);
    line-height: 1;
  }

  .cg-statement blockquote em {
    color: #ffd079;
  }

  .statement-copy {
    max-width: 38rem;
  }

  .statement-copy p + p {
    margin-top: 1rem;
  }

  .cg-avery {
    padding: clamp(5rem, 9vw, 8rem) 0;
    background: #ffe8db;
  }

  .avery-grid {
    display: grid;
    gap: 3rem;
    align-items: center;
  }

  .avery-photo-area {
    position: relative;
    min-height: 31rem;
  }

  .photo-shape {
    position: absolute;
    width: 19rem;
    height: 22rem;
    left: 1rem;
    top: 3rem;
    border-radius: 4rem 2rem 5rem 1rem;
    background: #778873;
    transform: rotate(-5deg);
  }

  .photo-card {
    position: absolute;
    z-index: 2;
    width: min(20rem, 80%);
    left: 4rem;
    top: 1rem;
    padding: .8rem .8rem 1.3rem;
    background: white;
    box-shadow: 0 22px 45px rgba(81,44,69,.16);
    transform: rotate(3deg);
  }

  .photo-card img {
    display: block;
    width: 100%;
  }

  .photo-card p {
    margin: .9rem 0 0;
    color: #512c45;
    font-family: Georgia, serif;
    font-weight: 700;
  }

  .tape {
    position: absolute;
    z-index: 4;
    width: 5rem;
    height: 1.5rem;
    left: calc(50% - 2.5rem);
    top: -.65rem;
    background: rgba(239,169,22,.55);
    transform: rotate(-4deg);
  }

  .avery-dots {
    position: absolute;
    z-index: 3;
    right: 1rem;
    bottom: 3rem;
    display: grid;
    grid-template-columns: repeat(3, .5rem);
    gap: .55rem;
  }

  .avery-copy h2 {
    max-width: 13ch;
    color: #512c45;
    font-family: Georgia, serif;
    font-size: clamp(2.8rem, 5vw, 4.7rem);
    font-weight: 500;
    line-height: 1;
  }

  .avery-copy h2 span {
    color: #ed5c31;
    font-style: italic;
  }

  .avery-copy p + p {
    margin-top: 1rem;
  }

  .avery-copy .underlined-link {
    display: inline-block;
    margin-top: 1.4rem;
  }

  .cg-approaches {
    display: grid;
  }

  .approach-copy {
    display: flex;
    align-items: center;
    padding: clamp(4rem, 8vw, 7rem) max(1.25rem, calc((100vw - 76rem) / 2));
    background: #5d334e;
    color: #f7e9e1;
  }

  .approach-copy h2 {
    max-width: 13ch;
    color: white;
    font-family: Georgia, serif;
    font-size: clamp(2.5rem, 5vw, 4.2rem);
    font-weight: 500;
  }

  .approach-copy .light {
    color: #ffc277;
  }

  .approach-copy p:not(.hand-label) {
    max-width: 36rem;
  }

  .approach-copy a {
    display: inline-block;
    margin-top: 1.5rem;
    color: white;
    font-weight: 800;
  }

  .approach-list {
    padding: clamp(3rem, 7vw, 6rem) max(1.25rem, calc((100vw - 76rem) / 2));
    background: #efa916;
  }

  .approach-list a {
    display: grid;
    grid-template-columns: 2.5rem 1fr auto;
    gap: 1rem;
    align-items: center;
    padding: 1.3rem 0;
    border-bottom: 2px solid rgba(81,44,69,.2);
    color: #512c45;
    text-decoration: none;
  }

  .approach-list span {
    font-size: .72rem;
    font-weight: 900;
  }

  .approach-list strong {
    font-size: 1.05rem;
  }

  .approach-list b {
    font-size: 1.4rem;
  }

  .cg-richmond {
    padding: clamp(4.5rem, 8vw, 7rem) 0;
    background: #fff8ed;
  }

  .richmond-card {
    display: grid;
    gap: 2rem;
    overflow: hidden;
    padding: clamp(2rem, 5vw, 4.5rem);
    border-radius: 2rem;
    background: #f47852;
  }

  .richmond-copy h2 {
    max-width: 10ch;
    color: #512c45;
    font-family: Georgia, serif;
    font-size: clamp(2.7rem, 5vw, 4.5rem);
    font-weight: 500;
    line-height: .95;
  }

  .richmond-copy h2 span {
    display: block;
    color: #fff8ed;
  }

  .richmond-art {
    position: relative;
    min-height: 17rem;
  }

  .big-dot {
    position: absolute;
    width: 8rem;
    height: 8rem;
    right: 2rem;

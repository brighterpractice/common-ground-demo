---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import { appointmentUrl } from '../data/site';
import { homepageServices } from '../data/services';
import {
  organizationSchema,
  websiteSchema,
  pageSchema,
} from '../lib/schema';
---

<Layout
  title="Align Therapy Group | Therapy in Madison, Wisconsin"
  description="Individual counseling in Madison, Wisconsin for adults navigating anxiety, burnout, relationship patterns, grief, major transitions, and difficult life experiences."
  schema={pageSchema([organizationSchema(), websiteSchema()])}
>
  <section class="align-hero">
    <div class="container align-hero-grid">
      <div class="align-hero-copy">
        <p class="eyebrow">Align Therapy Group · Madison, Wisconsin</p>

        <h1>
          Therapy for when life feels
          <span>out of alignment.</span>
        </h1>

        <p class="align-lead">
          Individual counseling for adults who want space to understand what is
          happening, reconnect with what matters, and move forward with greater
          clarity.
        </p>

        <div class="align-actions">
          <Button href={appointmentUrl} tracking="request-appointment">
            Request an appointment
          </Button>

          <a class="align-secondary" href="/services/">
            Explore services
          </a>
        </div>
      </div>

      <div class="align-art" aria-hidden="true">
        <div class="shape shape-a"></div>
        <div class="shape shape-b"></div>
        <div class="shape shape-c"></div>

        <div class="art-card art-card-main">
          <span class="art-line art-line-wide"></span>
          <span class="art-line"></span>
          <span class="art-line art-line-short"></span>

          <div class="art-person">
            <span class="person-head"></span>
            <span class="person-body"></span>
          </div>
        </div>

        <div class="art-card art-card-small">
          <span class="art-dot"></span>
          <span class="art-dot"></span>
          <span class="art-dot"></span>
        </div>
      </div>
    </div>
  </section>

  <section class="align-intro">
    <div class="container align-intro-grid">
      <div>
        <p class="eyebrow">A place to think clearly</p>
        <h2>Start with what feels hardest to sort through.</h2>
      </div>

      <div class="align-intro-copy">
        <p>
          You do not need to arrive with the right words or a perfectly defined
          goal. Therapy can begin with the part of life that currently feels
          confusing, heavy, repetitive, or difficult to manage.
        </p>

        <p>
          Together, the work can focus on understanding patterns, identifying
          what is getting in the way, and finding practical ways to move toward
          something different.
        </p>

        <a class="link-arrow" href="/about/">
          Learn about Align Therapy Group
        </a>
      </div>
    </div>
  </section>

  <section class="align-services">
    <div class="container">
      <div class="align-section-heading">
        <div>
          <p class="eyebrow">Areas of support</p>
          <h2>Support for the parts of life that can feel difficult to carry alone.</h2>
        </div>

        <a class="align-outline-link" href="/services/">
          View all services
        </a>
      </div>

      <div class="align-service-grid">
        {
          homepageServices.slice(0, 6).map((service, index) => (
            <a class="align-service-card" href={`/services/${service.slug}/`}>
              <span class="service-index">
                {String(index + 1).padStart(2, '0')}
              </span>

              <div>
                <h3>{service.title}</h3>
                <p>{service.summary}</p>
              </div>

              <span class="service-arrow">↗</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="align-methods">
    <div class="container align-methods-grid">
      <div class="align-methods-panel">
        <p class="eyebrow">How therapy can work</p>

        <h2>
          More than one way to understand what you are experiencing.
        </h2>

        <p>
          Jordan may draw from several counseling approaches depending on the
          focus of therapy, your preferences, and what seems useful in the work.
        </p>

        <a class="align-light-link" href="/approaches/">
          Explore therapy approaches →
        </a>
      </div>

      <div class="align-method-list">
        <a href="/approaches/internal-family-systems/">
          <span>01</span>
          <strong>Internal Family Systems</strong>
        </a>

        <a href="/approaches/somatic-experiencing/">
          <span>02</span>
          <strong>Somatic Experiencing</strong>
        </a>

        <a href="/approaches/emotionally-focused-therapy/">
          <span>03</span>
          <strong>Emotionally Focused Therapy</strong>
        </a>

        <a href="/approaches/mindfulness-based-therapy/">
          <span>04</span>
          <strong>Mindfulness-Based Therapy</strong>
        </a>
      </div>
    </div>
  </section>

  <section class="align-clinician">
    <div class="container align-clinician-grid">
      <div class="clinician-visual">
        <div class="clinician-block"></div>

        <div class="clinician-card">
          <div class="clinician-avatar">
            <span></span>
          </div>

          <p>Jordan Ellis, LPC</p>
          <small>Individual counseling for adults</small>
        </div>
      </div>

      <div class="clinician-copy">
        <p class="eyebrow">Meet Jordan</p>

        <h2>A collaborative approach to understanding what needs attention.</h2>

        <p>
          Jordan works with adults who may be navigating stress, anxiety,
          relationships, grief, transitions, emotional disconnection, or
          patterns that have become difficult to change on their own.
        </p>

        <p>
          Sessions are designed to be thoughtful, practical, and responsive to
          what each client needs from the process.
        </p>

        <a class="link-arrow" href="/about/jordan-ellis/">
          Meet Jordan Ellis, LPC
        </a>
      </div>
    </div>
  </section>

  <section class="align-steps">
    <div class="container">
      <div class="align-section-heading">
        <div>
          <p class="eyebrow">Getting started</p>
          <h2>A simple first step.</h2>
        </div>
      </div>

      <div class="align-step-grid">
        <div class="align-step">
          <span>01</span>
          <h3>Reach out</h3>
          <p>
            Request an appointment or contact the practice with a question.
          </p>
        </div>

        <div class="align-step">
          <span>02</span>
          <h3>Connect</h3>
          <p>
            Review practical details and determine whether the practice may be a
            good fit for what you are looking for.
          </p>
        </div>

        <div class="align-step">
          <span>03</span>
          <h3>Begin</h3>
          <p>
            Meet with Jordan and start with the concerns that matter most to
            you right now.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="align-location">
    <div class="container align-location-grid">
      <div>
        <p class="eyebrow">Madison, Wisconsin</p>
        <h2>Individual counseling in a modern, welcoming setting.</h2>

        <p>
          Align Therapy Group is based in Madison and welcomes adults from
          Madison and nearby communities.
        </p>
      </div>

      <div class="location-graphic" aria-hidden="true">
        <span class="location-ring ring-one"></span>
        <span class="location-ring ring-two"></span>
        <span class="location-dot"></span>
      </div>
    </div>
  </section>

  <section class="align-cta">
    <div class="container align-cta-inner">
      <div>
        <p class="eyebrow">A next step</p>
        <h2>See whether Align Therapy Group may be a good fit.</h2>
      </div>

      <Button
        href={appointmentUrl}
        variant="light"
        tracking="request-appointment"
      >
        Request an appointment
      </Button>
    </div>
  </section>
</Layout>

<style>
  .align-hero {
    position: relative;
    overflow: hidden;
    padding: clamp(4.5rem, 9vw, 8rem) 0;
    background:
      linear-gradient(135deg, #f6f9fd 0%, #eaf2fb 100%);
  }

  .align-hero:before {
    content: "";
    position: absolute;
    width: 32rem;
    height: 32rem;
    right: -11rem;
    top: -13rem;
    border-radius: 50%;
    background: rgba(48, 105, 190, .08);
  }

  .align-hero-grid {
    display: grid;
    gap: 3rem;
    align-items: center;
  }

  .align-hero-copy {
    position: relative;
    z-index: 2;
    max-width: 47rem;
  }

  .align-hero h1 {
    max-width: 11ch;
    font-size: clamp(3rem, 7vw, 6.3rem);
  }

  .align-hero h1 span {
    display: block;
    color: #5f82ad;
  }

  .align-lead {
    max-width: 42rem;
    margin-top: 1.5rem;
    color: #42546b;
    font-size: clamp(1.08rem, 1.6vw, 1.3rem);
  }

  .align-actions {
    display: flex;
    flex-wrap: wrap;
    gap: .85rem;
    margin-top: 2rem;
  }

  .align-secondary {
    display: inline-flex;
    min-height: 3rem;
    align-items: center;
    padding: .72rem 1.1rem;
    border: 1px solid #3f648d;
    border-radius: .55rem;
    color: #3f648d;
    font-weight: 750;
    text-decoration: none;
  }

  .align-art {
    position: relative;
    min-height: 29rem;
  }

  .shape {
    position: absolute;
  }

  .shape-a {
    width: 18rem;
    height: 18rem;
    right: 2rem;
    top: 1rem;
    border-radius: 3rem;
    background: #5f82ad;
    transform: rotate(10deg);
  }

  .shape-b {
    width: 15rem;
    height: 15rem;
    right: 10rem;
    bottom: 0;
    border-radius: 50%;
    background: #d7e6f7;
  }

  .shape-c {
    width: 8rem;
    height: 8rem;
    right: 0;
    bottom: 3rem;
    border-radius: 1.2rem;
    background: #a9bed6;
    transform: rotate(-12deg);
  }

  .art-card {
    position: absolute;
    border: 1px solid rgba(11,29,58,.12);
    background: rgba(255,255,255,.94);
    box-shadow: 0 22px 50px rgba(11,29,58,.14);
  }

  .art-card-main {
    width: min(21rem, 80%);
    min-height: 19rem;
    left: 1rem;
    top: 3rem;
    padding: 1.6rem;
    border-radius: 1rem;
  }

  .art-card-small {
    display: flex;
    gap: .45rem;
    right: 1rem;
    top: 13rem;
    padding: .8rem 1rem;
    border-radius: .7rem;
  }

  .art-line {
    display: block;
    width: 62%;
    height: .75rem;
    margin-bottom: .7rem;
    border-radius: .3rem;
    background: #dce7f4;
  }

  .art-line-wide {
    width: 88%;
    background: #aec5e1;
  }

  .art-line-short {
    width: 45%;
  }

  .art-dot {
    width: .65rem;
    height: .65rem;
    border-radius: 50%;
    background: #7793b3;
  }

  .art-person {
    position: absolute;
    right: 1.8rem;
    bottom: 1.6rem;
    width: 7rem;
    height: 8rem;
  }

  .person-head {
    position: absolute;
    left: 2.2rem;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background: #3f648d;
  }

  .person-body {
    position: absolute;
    left: .8rem;
    bottom: 0;
    width: 5.4rem;
    height: 5.7rem;
    border-radius: 2.8rem 2.8rem .8rem .8rem;
    background: #a9bed6;
  }

  .align-intro,
  .align-clinician,
  .align-steps,
  .align-location {
    padding: clamp(4rem, 8vw, 7rem) 0;
  }

  .align-intro-grid,
  .align-clinician-grid,
  .align-location-grid {
    display: grid;
    gap: 2.5rem;
  }

  .align-intro-copy p + p,
  .clinician-copy p + p {
    margin-top: 1rem;
  }

  .align-intro-copy .link-arrow,
  .clinician-copy .link-arrow {
    display: inline-block;
    margin-top: 1.2rem;
  }

  .align-services {
    padding: clamp(4rem, 8vw, 7rem) 0;
    background: #edf4fb;
  }

  .align-section-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 2.5rem;
  }

  .align-section-heading > div {
    max-width: 47rem;
  }

  .align-outline-link {
    color: #3f648d;
    font-weight: 750;
    text-decoration: none;
  }

  .align-service-grid {
    display: grid;
    gap: .75rem;
  }

  .align-service-card {
    display: grid;
    grid-template-columns: 2.5rem 1fr auto;
    gap: 1rem;
    align-items: center;
    padding: 1.25rem;
    border: 1px solid #d3dfed;
    border-radius: .7rem;
    background: white;
    color: #42546b;
    text-decoration: none;
    transition:
      transform .18s ease,
      border-color .18s ease,
      box-shadow .18s ease;
  }

  .align-service-card:hover {
    border-color: #a9bed6;
    box-shadow: 0 12px 30px rgba(11,29,58,.08);
    transform: translateY(-2px);
  }

  .align-service-card h3 {
    margin-bottom: .25rem;
  }

  .service-index {
    color: #5f82ad;
    font-size: .75rem;
    font-weight: 800;
  }

  .service-arrow {
    color: #3f648d;
    font-size: 1.2rem;
  }

  .align-methods {
    padding: clamp(4rem, 8vw, 7rem) 0;
    background: #0b1d3a;
    color: #dfe9f5;
  }

  .align-methods-grid {
    display: grid;
    gap: 2.5rem;
  }

  .align-methods h2 {
    color: white;
  }

  .align-methods .eyebrow {
    color: #b5c8df;
  }

  .align-methods-panel p:not(.eyebrow) {
    max-width: 38rem;
    margin-top: 1rem;
  }

  .align-light-link {
    display: inline-block;
    margin-top: 1.5rem;
    color: white;
    font-weight: 750;
    text-decoration: none;
  }

  .align-method-list {
    border-top: 1px solid rgba(255,255,255,.16);
  }

  .align-method-list a {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: 1rem;
    padding: 1.2rem 0;
    border-bottom: 1px solid rgba(255,255,255,.16);
    color: white;
    text-decoration: none;
  }

  .align-method-list span {
    color: #abc1da;
    font-size: .75rem;
    font-weight: 800;
  }

  .clinician-visual {
    position: relative;
    min-height: 27rem;
  }

  .clinician-block {
    position: absolute;
    inset: 2rem 4rem 0 0;
    border-radius: 1.5rem;
    background:
      linear-gradient(135deg, #5f82ad, #3f648d);
  }

  .clinician-card {
    position: absolute;
    right: 0;
    bottom: 1rem;
    width: min(20rem, 85%);
    padding: 1.5rem;
    border-radius: 1rem;
    background: white;
    box-shadow: 0 20px 50px rgba(11,29,58,.16);
  }

  .clinician-avatar {
    position: relative;
    width: 6rem;
    height: 6rem;
    margin-bottom: 1rem;
    overflow: hidden;
    border-radius: .7rem;
    background: #dce7f4;
  }

  .clinician-avatar:before {
    content: "";
    position: absolute;
    width: 2.4rem;
    height: 2.4rem;
    left: 1.8rem;
    top: .8rem;
    border-radius: 50%;
    background: #7793b3;
  }

  .clinician-avatar span {
    position: absolute;
    width: 5rem;
    height: 3.6rem;
    left: .5rem;
    bottom: -.3rem;
    border-radius: 2.8rem 2.8rem .7rem .7rem;
    background: #a9bed6;
  }

  .clinician-card p {
    color: #0b1d3a;
    font-weight: 800;
  }

  .clinician-card small {
    color: #6b7d93;
  }

  .align-step-grid {
    display: grid;
    gap: 1rem;
  }

  .align-step {
    padding: 1.5rem;
    border-left: 4px solid #5f82ad;
    background: #f3f7fc;
  }

  .align-step > span {
    color: #5f82ad;
    font-size: .75rem;
    font-weight: 800;
  }

  .align-step h3 {
    margin-top: .6rem;
  }

  .align-step p {
    margin-top: .5rem;
  }

  .align-location {
    background: #edf4fb;
  }

  .location-graphic {
    position: relative;
    min-height: 18rem;
  }

  .location-ring {
    position: absolute;
    border: 1px solid #7fa2ce;
    border-radius: 50%;
  }

  .ring-one {
    width: 13rem;
    height: 13rem;
    right: 4rem;
    top: 2rem;
  }

  .ring-two {
    width: 8rem;
    height: 8rem;
    right: 1rem;
    top: 7rem;
  }

  .location-dot {
    position: absolute;
    width: 2rem;
    height: 2rem;
    right: 7rem;
    top: 7rem;
    border-radius: 50%;
    background: #5f82ad;
    box-shadow: 0 0 0 1.2rem rgba(29,78,216,.12);
  }

  .align-cta {
    padding: clamp(4rem, 8vw, 6rem) 0;
    background: #294c70;
    color: #dfe9f5;
  }

  .align-cta-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
  }

  .align-cta h2 {
    max-width: 18ch;
    color: white;
  }

  .align-cta .eyebrow {
    color: #bfd0e3;
  }

  @media (min-width: 48rem) {
    .align-hero-grid {
      grid-template-columns: 1.05fr .95fr;
      gap: clamp(3rem, 7vw, 7rem);
    }

    .align-intro-grid,
    .align-clinician-grid,
    .align-location-grid {
      grid-template-columns: .9fr 1.1fr;
      gap: clamp(3rem, 7vw, 7rem);
      align-items: center;
    }

    .align-methods-grid {
      grid-template-columns: .9fr 1.1fr;
      gap: clamp(3rem, 7vw, 7rem);
      align-items: start;
    }

    .align-service-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .align-step-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 47.999rem) {
    .align-hero {
      padding-top: 3.75rem;
    }

    .align-art {
      min-height: 23rem;
    }

    .shape-a {
      width: 14rem;
      height: 14rem;
      right: .5rem;
    }

    .shape-b {
      width: 11rem;
      height: 11rem;
      right: 7rem;
    }

    .shape-c {
      width: 6rem;
      height: 6rem;
    }

    .art-card-main {
      width: 78%;
      min-height: 15rem;
      left: .25rem;
    }

    .align-actions {
      display: grid;
    }

    .align-actions > * {
      width: 100%;
      justify-content: center;
    }

    .align-section-heading {
      align-items: start;
    }

    .align-service-card {
      grid-template-columns: 2rem 1fr auto;
      padding: 1rem;
    }

    .align-service-card p {
      font-size: .9rem;
    }

    .clinician-visual {
      min-height: 22rem;
    }

    .clinician-block {
      inset: 1rem 3rem 0 0;
    }

    .location-graphic {
      min-height: 13rem;
    }
  }
</style>

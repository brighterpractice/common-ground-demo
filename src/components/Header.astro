---
import Button from './Button.astro';
import {
  appointmentUrl,
  clientPortalUrl,
  externalLinkAttrs,
} from '../data/site';

const path = Astro.url.pathname;
const portalAttrs = externalLinkAttrs();

const primaryLinks = [
  { label: 'Home', href: '/' },
  { label: 'Our Place', href: '/about/' },
  { label: 'What We Help With', href: '/services/' },
  { label: 'How We Work', href: '/approaches/' },
  { label: 'Meet Avery', href: '/about/avery-morgan/' },
  { label: 'Contact', href: '/contact/' },
];

const isCurrent = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<header class="site-header">
  <div class="masthead">
    <div class="container masthead-inner">
      <a class="brand" href="/" aria-label="Common Ground Therapy home">
        <img
          src="/images/branding/common-ground-wordmark.png"
          width="360"
          height="101"
          alt="Common Ground Therapy"
          fetchpriority="high"
        />
      </a>

      <p class="practice-note">
        Individual counseling for adults
        <span>Richmond, Virginia</span>
      </p>

      <div class="desktop-actions">
        <a
          class="portal-link"
          href={clientPortalUrl}
          target={portalAttrs.target}
          rel={portalAttrs.rel}
          data-track="client-portal"
        >
          Client portal
        </a>

        <Button href={appointmentUrl} tracking="request-appointment">
          Request appointment
        </Button>
      </div>

      <details class="mobile-menu">
        <summary>
          <span class="menu-label">Menu</span>
          <span class="menu-icon" aria-hidden="true"><i></i><i></i></span>
        </summary>

        <nav aria-label="Mobile navigation" data-track="mobile-navigation">
          {
            primaryLinks.map((item) => (
              <a
                href={item.href}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
              >
                <span>{item.label}</span>
                <b aria-hidden="true">↗</b>
              </a>
            ))
          }

          <div class="mobile-actions">
            <a
              href={clientPortalUrl}
              target={portalAttrs.target}
              rel={portalAttrs.rel}
              data-track="client-portal"
            >
              Client portal
            </a>
            <Button href={appointmentUrl} tracking="request-appointment">
              Request appointment
            </Button>
          </div>
        </nav>
      </details>
    </div>
  </div>

  <nav class="community-nav" aria-label="Primary navigation" data-track="primary-navigation">
    <div class="container community-nav-inner">
      {
        primaryLinks.map((item) => (
          <a
            href={item.href}
            aria-current={isCurrent(item.href) ? 'page' : undefined}
          >
            <span>{item.label}</span>
          </a>
        ))
      }
    </div>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid rgba(81,44,69,.16);
    background: #fff8ed;
  }

  .masthead {
    background: rgba(255,248,237,.96);
    backdrop-filter: blur(14px);
  }

  .masthead-inner {
    display: flex;
    min-height: 5.2rem;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
  }

  .brand {
    display: flex;
    min-width: 0;
    min-height: 44px;
    align-items: center;
    text-decoration: none;
  }

  .brand img {
    display: block;
    width: clamp(9.5rem,18vw,12.5rem);
    height: auto;
  }

  .practice-note,
  .desktop-actions,
  .community-nav {
    display: none;
  }

  .mobile-menu { flex: 0 0 auto; }

  .mobile-menu > summary {
    display: flex;
    min-width: 5.4rem;
    min-height: 44px;
    cursor: pointer;
    list-style: none;
    align-items: center;
    justify-content: center;
    gap: .65rem;
    border: 1px solid #512c45;
    border-radius: 999px;
    color: #512c45;
    font-size: .82rem;
    font-weight: 850;
  }

  .mobile-menu > summary::-webkit-details-marker { display: none; }

  .menu-icon {
    position: relative;
    display: block;
    width: 1rem;
    height: .75rem;
  }

  .menu-icon i {
    position: absolute;
    left: 0;
    width: 1rem;
    height: 2px;
    background: currentColor;
    transition: transform .2s ease, top .2s ease;
  }

  .menu-icon i:first-child { top: .15rem; }
  .menu-icon i:last-child { top: .55rem; }
  .mobile-menu[open] .menu-icon i:first-child { top: .35rem; transform: rotate(45deg); }
  .mobile-menu[open] .menu-icon i:last-child { top: .35rem; transform: rotate(-45deg); }

  .mobile-menu nav {
    position: absolute;
    top: 100%;
    left: 0;
    display: grid;
    width: 100%;
    max-height: calc(100dvh - 5.2rem);
    overflow: auto;
    overscroll-behavior: contain;
    padding: .75rem 1.25rem calc(1.5rem + env(safe-area-inset-bottom));
    border-top: 1px solid #edd9c8;
    border-bottom: 1px solid #dca68a;
    background: #fff8ed;
    box-shadow: 0 1.2rem 2.8rem rgba(81,44,69,.16);
  }

  .mobile-menu nav > a {
    display: grid;
    grid-template-columns: 1fr auto;
    min-height: 3.9rem;
    align-items: center;
    gap: .8rem;
    padding: .5rem .85rem;
    border-bottom: 1px solid #edd9c8;
    color: #512c45;
    text-decoration: none;
  }

  .mobile-menu nav > a span {
    font-family: Georgia,"Times New Roman",serif;
    font-size: 1.15rem;
  }

  .mobile-menu nav > a b { color: #d85f40; }
  .mobile-menu nav > a[aria-current="page"] { border-radius: .65rem; background: #f3c95d; }

  .mobile-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    padding-top: 1.2rem;
  }

  .mobile-actions > a {
    color: #512c45;
    font-size: .85rem;
    font-weight: 800;
  }

  /* Decorative editorial numbering was part of the original concept but did
     not carry useful meaning. Remove it consistently across overview and
     detail pages while keeping the color, shape, and collage language. */
  :global(.section-number),
  :global(.hero-poster > strong),
  :global(.process-card > .number),
  :global(.statement-number),
  :global(.approach-list > a > span:first-child),
  :global(.manifesto-number),
  :global(.principle > span:first-child),
  :global(.starting-statement > span:first-child),
  :global(.method-number),
  :global(.methods-heading > span:first-child),
  :global(.background-statement > span:first-child),
  :global(.start-poster > strong),
  :global(.next-cards > li > span:first-child),
  :global(.tile-number),
  :global(.bridge-statement > span:first-child),
  :global(.section-mark),
  :global(.experience-heading > span:first-child),
  :global(.experience-item > span:first-child),
  :global(.help-title > span:first-child),
  :global(.whole-number),
  :global(.band-index),
  :global(.considerations-title > span:first-child),
  :global(.consideration > span:first-child),
  :global(.related-links > a > span:first-child) {
    display: none !important;
  }

  :global(.approach-list > a),
  :global(.related-links > a) {
    grid-template-columns: 1fr auto !important;
  }

  :global(.experience-item),
  :global(.consideration) {
    grid-template-columns: 1fr !important;
  }

  @media (min-width:64rem) {
    .masthead-inner { min-height: 5.7rem; }

    .practice-note,
    .desktop-actions,
    .community-nav { display: flex; }

    .mobile-menu { display: none; }

    .practice-note {
      margin: 0 auto 0 1.2rem;
      padding-left: 1.2rem;
      border-left: 1px solid #dcbda8;
      color: #765f68;
      font-size: .76rem;
      font-weight: 750;
      line-height: 1.35;
    }

    .practice-note span { display: block; color: #a74636; }
    .desktop-actions { align-items: center; gap: 1rem; }

    .portal-link {
      color: #512c45;
      font-size: .82rem;
      font-weight: 800;
      white-space: nowrap;
    }

    .community-nav { background: #512c45; }

    .community-nav-inner {
      display: grid;
      grid-template-columns: repeat(6,1fr);
      min-height: 3.65rem;
      padding-inline: 0;
    }

    .community-nav a {
      position: relative;
      display: flex;
      min-width: 0;
      align-items: center;
      justify-content: center;
      padding: .8rem clamp(.65rem,1.2vw,1.1rem);
      border-left: 1px solid rgba(255,248,237,.16);
      color: #fff8ed;
      text-decoration: none;
      transition: background .18s ease,color .18s ease,transform .18s ease;
    }

    .community-nav a:last-child { border-right: 1px solid rgba(255,248,237,.16); }

    .community-nav span {
      overflow: hidden;
      font-size: clamp(.72rem,.92vw,.86rem);
      font-weight: 820;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .community-nav a:nth-child(2):hover,
    .community-nav a:nth-child(2)[aria-current="page"] { background: #d85f40; }

    .community-nav a:nth-child(3):hover,
    .community-nav a:nth-child(3)[aria-current="page"] { background: #ef8a4c; color: #3d2634; }

    .community-nav a:nth-child(4):hover,
    .community-nav a:nth-child(4)[aria-current="page"] { background: #f3c95d; color: #3d2634; }

    .community-nav a:nth-child(5):hover,
    .community-nav a:nth-child(5)[aria-current="page"] { background: #9a5e63; }

    .community-nav a:first-child:hover,
    .community-nav a:first-child[aria-current="page"],
    .community-nav a:last-child:hover,
    .community-nav a:last-child[aria-current="page"] { background: #7f4565; }

    .community-nav a:hover,
    .community-nav a[aria-current="page"] { transform: translateY(-2px); }
  }

  @media (min-width:48rem) {
    :global(.detail-lead-grid),
    :global(.whole-person-grid),
    :global(.band-grid) {
      grid-template-columns: 1fr 1fr !important;
    }
  }

  @media (min-width:76rem) {
    .community-nav-inner { padding-inline: var(--gutter); }
  }

  @media (prefers-reduced-motion: reduce) {
    .community-nav a,
    .menu-icon i { transition: none; }
  }
</style>

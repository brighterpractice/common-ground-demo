---
import Breadcrumbs from './Breadcrumbs.astro';

interface Props {
  eyebrow?: string;
  title: string;
  intro: string;
  crumbs?: { label: string; href?: string }[];
}

const { eyebrow, title, intro, crumbs } = Astro.props;
---

<section class="cg-page-hero">
  <div class="container cg-page-hero-grid">
    <div class="hero-meta">
      {crumbs && <Breadcrumbs items={crumbs} />}
      {eyebrow && <p class="hero-kicker">{eyebrow}</p>}
    </div>

    <div class="hero-copy">
      <h1>{title}</h1>
      <p class="intro">{intro}</p>
    </div>

    <div class="hero-poster" aria-hidden="true">
      <span class="poster-plum"></span>
      <span class="poster-coral"></span>
      <span class="poster-gold"></span>
      <span class="poster-dot dot-one"></span>
      <span class="poster-dot dot-two"></span>
      <span class="poster-line"></span>
    </div>
  </div>
</section>

<style>
  .cg-page-hero {
    position: relative;
    overflow: hidden;
    padding: clamp(3.5rem, 7vw, 6.5rem) 0;
    border-bottom: 1px solid rgba(81,44,69,.1);
    background: #fff8ed;
  }

  .cg-page-hero::before {
    position: absolute;
    inset: auto 0 0;
    height: .55rem;
    background: linear-gradient(90deg,#ed6d4f 0 31%,#f4b21a 31% 58%,#7f4565 58% 80%,#788873 80%);
    content: '';
  }

  .cg-page-hero-grid {
    display: grid;
    gap: 2.25rem;
    align-items: center;
  }

  .hero-meta {
    align-self: start;
  }

  .hero-kicker {
    margin: 1.2rem 0 0;
    color: #d85f40;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 1rem;
    font-style: italic;
    font-weight: 700;
  }

  .hero-copy h1 {
    max-width: 12ch;
    margin: 0;
    color: #512c45;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(3rem, 6.5vw, 6rem);
    font-weight: 500;
    line-height: .94;
    letter-spacing: -.055em;
  }

  .intro {
    max-width: 42rem;
    margin: 1.5rem 0 0;
    color: #6c5660;
    font-size: clamp(1.04rem, 1.5vw, 1.22rem);
    line-height: 1.7;
  }

  .hero-poster {
    position: relative;
    min-height: 18rem;
    isolation: isolate;
  }

  .hero-poster span {
    position: absolute;
    display: block;
  }

  .poster-plum {
    width: 10.5rem;
    height: 13.5rem;
    right: 1.5rem;
    top: 1rem;
    border-radius: 5.8rem 5.8rem 1.2rem 1.2rem;
    background: #7f4565;
    transform: rotate(5deg);
  }

  .poster-coral {
    width: 11rem;
    height: 7.5rem;
    left: 1rem;
    bottom: 1.25rem;
    border-radius: 5rem 1.2rem 5rem 1.2rem;
    background: #f17855;
    transform: rotate(-8deg);
  }

  .poster-gold {
    width: 6.2rem;
    height: 6.2rem;
    right: 8.8rem;
    bottom: 1rem;
    border-radius: 50%;
    background: #f4b21a;
  }

  .poster-dot {
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 50%;
    background: #fff1df;
    z-index: 2;
  }

  .dot-one { right: 5.2rem; top: 5rem; }
  .dot-two { right: 2.7rem; top: 7.2rem; }

  .poster-line {
    width: 8rem;
    height: .2rem;
    left: 3.6rem;
    top: 6.2rem;
    background: #512c45;
    transform: rotate(-12deg);
    transform-origin: left center;
  }

  @media (min-width:48rem) {
    .cg-page-hero-grid {
      grid-template-columns: .28fr 1.05fr .67fr;
      gap: clamp(2rem,4.5vw,5rem);
      align-items: center;
    }

    .hero-poster {
      min-height: 22rem;
    }
  }
</style>
